# ==========================================
# InvoiceOps Production & Runtime Config
# ==========================================

APP_ENV=production
APP_NAME=InvoiceOps
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./data/invoiceops.db

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15

# Security & CORS
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:3000,*
JWT_SECRET=invoiceops-secure-signing-key-change-in-production

# Switch Multi-Agent Room Configuration
SWITCH_SERVER_URL=http://localhost:8080
SWITCH_ROOM_ID=room_invoiceops_ap

# Matching Tolerances (Pure Decimal Arithmetic)
DEFAULT_CURRENCY=INR
PRICE_VARIANCE_PERCENT=0.50
PRICE_VARIANCE_ABSOLUTE_PAISE=100
QUANTITY_TOLERANCE=0
EXTRACTION_CONFIDENCE_THRESHOLD=0.90

